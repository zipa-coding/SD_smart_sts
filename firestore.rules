rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Izinkan akses read dan write untuk database Raport STS
    match /teachers/{teacherId} {
      allow read, write: if true;
    }
    match /guru/{guruId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /siswa/{siswaId} {
      allow read, write: if true;
    }
    match /grades/{gradeId} {
      allow read, write: if true;
    }
    match /walikelas_notes/{studentId} {
      allow read, write: if true;
    }
    match /tujuan_pembelajaran_templates/{subjectId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /ekskul/{ekskulId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

